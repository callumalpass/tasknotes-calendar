{
	"name": "@tasknotes/calendar",
	"version": "0.1.0-dev.0",
	"description": "Task-native calendar engine for TaskNotes: incremental layout, time grid, month, list, year and timeline views.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/callumalpass/tasknotes-calendar.git"
	},
	"main": "./dist/esm/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js"
		},
		"./core": {
			"types": "./dist/types/core/index.d.ts",
			"import": "./dist/esm/core.js"
		},
		"./react": {
			"types": "./dist/types/react/index.d.ts",
			"import": "./dist/esm/react.js"
		},
		"./calendar.css": "./dist/calendar.css"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"*.css"
	],
	"peerDependencies": {
		"react": ">=18"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "npm run clean && node scripts/build.mjs && tsc -p tsconfig.types.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint src test",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:browser": "playwright test",
		"playground": "node scripts/playground.mjs",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"happy-dom": "^21.0.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
